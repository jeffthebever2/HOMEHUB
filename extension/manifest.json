{
  "manifest_version": 3,
  "name": "HomeHub Music Bridge",
  "version": "1.0.0",
  "description": "Bridges YouTube Music playback to HomeHub dashboard",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "permissions": ["tabs"],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["*://music.youtube.com/*"],
      "js": ["content-ytmusic.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://localhost/*",
        "*://127.0.0.1/*",
        "*://*.vercel.app/*",
        "*://*.homehub.app/*"
      ],
      "js": ["content-homehub.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_title": "HomeHub Music Bridge"
  }
}
